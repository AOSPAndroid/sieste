{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:cache": "node scripts/test-device-cache.mjs && node scripts/test-auto-sync.mjs && node scripts/test-account-metadata.mjs",
    "test:notifications": "node scripts/test-activity-alerts.mjs",
    "test:import": "node scripts/test-activity-import.mjs",
    "test:sync": "node scripts/test-progressive-sync.mjs && node scripts/test-health-sync-fallback.mjs",
    "typecheck": "tsc --noEmit --incremental false --noUnusedLocals --noUnusedParameters",
    "audit:code": "node scripts/audit-code.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "test:overview": "node scripts/test-compact-load-chart.mjs && node scripts/test-fatigue-recovery.mjs && node scripts/test-load-analysis.mjs && node scripts/test-load-recovery-trends.mjs && node scripts/test-weekly-volume.mjs && node scripts/test-widget-comparisons.mjs",
    "test:share": "node scripts/test-activity-share.mjs && node scripts/test-cinematic-share.mjs && node scripts/test-cinematic-concepts.mjs && node scripts/test-share-languages.mjs && node scripts/test-complete-finishes.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.214.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
