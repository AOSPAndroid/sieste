TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Approved Garmin Connect Developer application. Keep the client secret server-side.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Background bridge: generate a random service token and VAPID key pair locally.
# Keep the matching VAPID private key only in the PC's private config.
SYNC_BRIDGE_TOKEN=
SYNC_VAPID_PUBLIC_KEY=
